rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isLegend() { return signedIn() && request.auth.token.email == 'legend@users.famy-app.invalid'; }
    function member(data) { return signedIn() && request.auth.uid in data.memberIds; }
    function canSeeProfile(data) {
      return signedIn() && (data.username != 'lucy' || data.uid == request.auth.uid || isLegend());
    }
    function membersRespectLucy(members) {
      let lucyPath = /databases/$(database)/documents/usernames/lucy;
      return isLegend() || !exists(lucyPath) || !(get(lucyPath).data.uid in members);
    }
    function canReadMembers(members) {
      let lucyPath = /databases/$(database)/documents/usernames/lucy;
      return !exists(lucyPath) || !(get(lucyPath).data.uid in members)
        || isLegend() || request.auth.uid == get(lucyPath).data.uid;
    }

    // Username index is readable for username search. A user can only claim
    // their own username and cannot change the owner after creation.
    match /usernames/{username} {
      // Exact gets are used to check whether a username is available. Permit
      // a signed-in get to a missing doc without exposing Lucy's existing doc.
      allow get: if signedIn() && (username != 'lucy' || isLegend() || request.auth.token.email == 'lucy@users.famy-app.invalid');
      allow list: if signedIn() && (resource.data.username != 'lucy' || isLegend());
      allow create: if signedIn()
        && request.auth.token.email == username + '@users.famy-app.invalid'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/users/$(uid)) || canSeeProfile(resource.data));
      allow list: if canSeeProfile(resource.data);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /conversations/{conversationId} {
      // The direct-chat flow reads the deterministic conversation ID before
      // creating it. A missing conversation contains no data to disclose.
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/conversations/$(conversationId))
          || (member(resource.data) && canReadMembers(resource.data.memberIds)));
      allow list: if member(resource.data) && canReadMembers(resource.data.memberIds);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() >= 2
        && membersRespectLucy(request.resource.data.memberIds)
        && ((request.resource.data.isGroup == true
              && request.resource.data.groupName is string
              && request.resource.data.groupName.size() >= 2
              && request.resource.data.groupName.size() <= 40)
            || (request.resource.data.isGroup != true
              && request.resource.data.memberIds.size() == 2));
      allow update: if member(resource.data) && canReadMembers(resource.data.memberIds)
        && request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if false;

      match /messages/{messageId} {
        function parent() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        allow read: if signedIn() && request.auth.uid in parent().memberIds
          && canReadMembers(parent().memberIds);
        allow create: if signedIn() && request.auth.uid in parent().memberIds
          && canReadMembers(parent().memberIds)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if signedIn() && request.auth.uid in parent().memberIds
          && canReadMembers(parent().memberIds)
          && request.resource.data.senderId == resource.data.senderId;
        allow delete: if false;
      }
    }

    match /calls/{callId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds && canReadMembers(resource.data.memberIds);
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds
        && membersRespectLucy(request.resource.data.memberIds);
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds && canReadMembers(resource.data.memberIds)
        && request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if false;
    }
  }
}
