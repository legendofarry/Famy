# Firebase web configuration (safe to expose in the browser; protect data with Firestore rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary unsigned upload configuration. Create an unsigned upload preset in Cloudinary.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Local Vite hot reload port.
VITE_HMR_PORT=24679
